#!/bin/sh
# Turns settings from ~/.config/the-line/config.json into the files other programs read. Run by the shell when a
# setting changes, and at login (idle, readme):
#   idle        ~/.config/the-line/hypridle.conf, then (re)starts hypridle with it
#   workspaces  ~/.config/the-line/hypr/workspaces.lua (apps that open on their workspace), then reloads Hyprland
#   keys        ~/.config/the-line/hypr/keys.lua (The Line's keys moved or turned off), then reloads Hyprland
#   input       ~/.config/the-line/hypr/input.lua (keyboard, mouse, touchpad), then reloads Hyprland
#   accent      the accent outside the shell: window borders (live), and the cursor, rebuilt in that colour into
#               ~/.local/share/icons/TheLine (cursor/build.py, needs python3 + Pillow), then reloaded
#   theme       other apps in The Line's colours: ~/.config/gtk-{3,4}.0/gtk.css and the Kvantum theme TheLine
#               (also part of accent), and the icon theme (iconTheme) for GTK and Qt (qt6ct)
#   readme      ~/.config/the-line/README.md: which file holds what, and who writes it
# The generated files are rewritten from config.json each time: change these settings in Settings, not in them.

cfg="$HOME/.config/the-line/config.json"
dir="$HOME/.config/the-line"
mkdir -p "$dir/hypr"

# A number from config.json, or the default.
num() {
    v=$(jq -r ".$1 // empty" "$cfg" 2>/dev/null)
    case "$v" in ''|*[!0-9]*) echo "$2" ;; *) echo "$v" ;; esac
}

idle() {
    dim=$(num idleDim 10)
    lock=$(num idleLock 30)
    suspend=$(num idleSuspend 60)
    {
        echo "# Written by The Line from config.json (Settings > Power & idle) at each change and each login."
        echo "# Edits here are replaced: change the times in Settings. 0 = never. The screens are never turned off."
        echo
        echo "general {"
        echo "    lock_cmd = pidof hyprlock || hyprlock"
        echo "    before_sleep_cmd = loginctl lock-session"
        echo "}"
        if [ "$dim" -gt 0 ]; then
            printf '\nlistener {\n    timeout = %s\n    on-timeout = brightnessctl -s set 10%%\n    on-resume = brightnessctl -r\n}\n' $((dim * 60))
        fi
        if [ "$lock" -gt 0 ]; then
            printf '\nlistener {\n    timeout = %s\n    on-timeout = loginctl lock-session\n}\n' $((lock * 60))
        fi
        if [ "$suspend" -gt 0 ]; then
            printf '\nlistener {\n    timeout = %s\n    on-timeout = loginctl suspend\n}\n' $((suspend * 60))
        fi
    } > "$dir/hypridle.conf.new" && mv "$dir/hypridle.conf.new" "$dir/hypridle.conf"
    pkill -x hypridle
    setsid -f hypridle -c "$dir/hypridle.conf" >/dev/null 2>&1
}

workspaces() {
    out="$dir/hypr/workspaces.lua"
    {
        echo "-- Written by The Line from config.json (Settings > Workspaces > Apps on their workspace)."
        echo "-- Edits here are replaced: change the list in Settings."
        jq -r '.workspaceApps[]? | select(.class != null and .workspace != null) | "\(.workspace)\t\(.class)"' "$cfg" 2>/dev/null |
        while IFS="$(printf '\t')" read -r ws cls; do
            # the class is a regex in a Lua string: escape it for both
            pat=$(printf '%s' "$cls" | tr -d '"' | sed 's/[][\.*^$+?(){}|]/\\\\&/g')
            printf 'hl.window_rule({ match = { class = "^(%s)$" }, workspace = "%s" })\n' "$pat" "$ws"
        done
    } > "$out.new" && mv "$out.new" "$out"
    hyprctl reload >/dev/null 2>&1
}

keys() {
    out="$dir/hypr/keys.lua"
    {
        echo "-- Written by The Line from config.json (Settings > Shortcuts): The Line's keys you moved (\"\" = off)."
        echo "-- Edits here are replaced: change them in Settings. Your app keys are in apps.lua."
        echo "the_line_keys = {"
        # only key names (letters, digits, _ : +): nothing else reaches the Lua
        jq -r '.keys // {} | to_entries[] | "\(.key)\u001f\(.value.to // "")\u001f\(.value.desc // "" | gsub("[\\n\\\\]"; " "))"' "$cfg" 2>/dev/null |
        # a separator that isn't white space: an empty "to" (turned off) stays a field
        while IFS="$(printf '\037')" read -r from to desc; do
            printf '%s' "$from" | grep -Eq '^[A-Za-z0-9_:+]+$' || continue
            [ -z "$to" ] || printf '%s' "$to" | grep -Eq '^[A-Za-z0-9_:+]+$' || continue
            printf '    ["%s"] = "%s",   -- %s\n' "$from" "$to" "$desc"
        done
        echo "}"
    } > "$out.new" && mv "$out.new" "$out"
    hyprctl reload >/dev/null 2>&1
}

# Settings > Input. Its defaults are the session's own (session/hyprland.lua); an empty layout keeps the console's.
input() {
    out="$dir/hypr/input.lua"
    {
        echo "-- Written by The Line from config.json (Settings > Input). Edits here are replaced: change them in"
        echo "-- Settings, or put your own in custom.lua (loaded after this file)."
        jq -r '
            def str($k; $re): if (.[$k] | type) == "string" and (.[$k] | test($re)) then .[$k] else empty end;
            def num($k): if (.[$k] | type) == "number" then .[$k] else empty end;
            def bool($k): if (.[$k] | type) == "boolean" then .[$k] else empty end;
            [
              (str("kbLayout"; "^[a-z0-9_,()-]+$") | "kb_layout = \"\(.)\""),
              (if has("kbLayout") then (.kbVariant // "" | select(test("^[A-Za-z0-9_,()-]*$")) | "kb_variant = \"\(.)\"") else empty end),
              (if has("kbOptions") then (.kbOptions // "" | select(test("^[a-z0-9_,:-]*$")) | "kb_options = \"\(.)\"") else empty end),
              (num("repeatDelay") | "repeat_delay = \(.)"),
              (num("repeatRate") | "repeat_rate = \(.)"),
              (bool("numlock") | "numlock_by_default = \(.)"),
              (num("pointerSpeed") | "sensitivity = \(.)"),
              (str("pointerAccel"; "^(flat|adaptive)$") | "accel_profile = \"\(.)\""),
              ([ (bool("naturalScroll") | "natural_scroll = \(.)"),
                 (bool("tapToClick") | "tap_to_click = \(.)"),
                 (bool("disableWhileTyping") | "disable_while_typing = \(.)"),
                 (num("touchpadScroll") | "scroll_factor = \(.)") ]
               | select(length > 0) | "touchpad = { " + join(", ") + " }")
            ] | select(length > 0) | "hl.config({ input = {\n        " + join(",\n        ") + "\n} })"
        ' "$cfg" 2>/dev/null
        # the touchpad's own speed, on each touchpad Hyprland knows (the mouse keeps `sensitivity`)
        speed=$(jq -r '.touchpadSpeed // empty | numbers' "$cfg" 2>/dev/null)
        if [ -n "$speed" ]; then
            hyprctl devices -j 2>/dev/null | jq -r '.mice[].name | select(test("touchpad"; "i"))' |
            while read -r pad; do
                printf '%s' "$pad" | grep -Eq '^[A-Za-z0-9:._()-]+$' || continue
                printf 'hl.device({ name = "%s", sensitivity = %s })\n' "$pad" "$speed"
            done
        fi
    } > "$out.new" && mv "$out.new" "$out"
    hyprctl reload >/dev/null 2>&1
}

accent() {
    hex=$(jq -r '.accent // "#9A5CFF"' "$cfg" 2>/dev/null | tr -d '#' | tr 'A-F' 'a-f')
    case "$hex" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; *) hex=9a5cff ;; esac
    hyprctl dispatch "function() hl.config({ general = { col = { active_border = \"rgba(${hex}ff)\" } } }) end" >/dev/null 2>&1

    icons="$HOME/.local/share/icons"
    shell="${THE_LINE_DIR:-/usr/share/the-line}"
    rm -rf "$icons/.TheLine.new"
    if THE_LINE_ACCENT="#$hex" python3 "$shell/cursor/build.py" "$icons/.TheLine.new" >/dev/null 2>&1; then
        rm -rf "$icons/TheLine"
        mv "$icons/.TheLine.new" "$icons/TheLine"
        hyprctl setcursor TheLine "${HYPRCURSOR_SIZE:-24}" >/dev/null 2>&1
    fi
    theme
}

# Other apps in The Line's colours: GTK (gtk.css) and Qt (a Kvantum theme). Apps pick it up when they start again.
theme() {
    hex=$(jq -r '.accent // "#9A5CFF"' "$cfg" 2>/dev/null)
    icons=$(jq -r '.iconTheme // ""' "$cfg" 2>/dev/null)
    python3 "${THE_LINE_DIR:-/usr/share/the-line}/session/the-line-app-theme" "$hex" "$icons" >/dev/null 2>&1
}

readme() {
    cat > "$dir/README.md" <<'EOF'
# Your settings for The Line

Everything in this folder is yours: updates never touch it. (This README is rewritten at each login.)
The Line itself lives in /usr/share/the-line, which every update replaces: don't change anything there.

| File | What | Written by |
|---|---|---|
| config.json | every setting of the shell and the Settings app | Settings and the shell; editable by hand |
| quotes.txt | your own lines for Kira's voice (one per line), if you make it | you |
| hypridle.conf | idle times (dim, lock, suspend) | generated from config.json: edits are replaced |
| hypr/custom.lua | your own Hyprland settings, loaded last | you, never overwritten |
| hypr/apps.lua | your app keys | you, and Settings > Shortcuts (it changes only its lines) |
| hypr/monitors.lua | your screens | Settings > Displays, and you: a screen's line is rewritten when you change it there |
| hypr/input.lua | keyboard, mouse, touchpad | generated from config.json (Settings > Input): edits are replaced |
| ../gtk-3.0/gtk.css, ../gtk-4.0/gtk.css | GTK apps in The Line's colours | generated (accent): edits are replaced; yours before is kept as .before-the-line |
| ../Kvantum/TheLine | Qt apps in The Line's colours (Kvantum) | generated (accent): edits are replaced |
| hypr/keys.lua | The Line's keys you moved or turned off | generated from config.json (Settings > Shortcuts): edits are replaced |
| hypr/floating.lua | the apps you float, with their size and place | generated by the shell: edits are replaced |
| hypr/workspaces.lua | apps that open on their workspace | generated from config.json: edits are replaced |

Not settings, kept in ~/.local/state/the-line (safe from updates too): launch counts (apps.json), floating
windows' places (floating.json), recent emoji (emoji-recent.json).
EOF
}

case "$1" in
    idle) idle ;;
    workspaces) workspaces ;;
    keys) keys ;;
    input) input ;;
    accent) accent ;;
    theme) theme ;;
    readme) readme ;;
    *) echo "usage: the-line-apply idle|workspaces|keys|input|accent|theme|readme" >&2; exit 1 ;;
esac
