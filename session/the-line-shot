#!/bin/sh
# Area screenshot, SUPER+SHIFT+S.
# With Flameshot: its editor, straight on the focused screen (no "which monitor?" prompt; Flameshot numbers the
# screens like Hyprland's monitor ids). Its defaults: session/flameshot.ini.
# Without it: to the clipboard, any screen or several, the screens frozen while you select: each one is captured
# first (without the cursor), The Line shows the captures over the screens, slurp selects on top of them, and
# the area is cut out of that frozen picture.

if command -v flameshot >/dev/null 2>&1; then
    exec flameshot screen -n "$(hyprctl -j monitors | jq '.[] | select(.focused) | .id')" -e
fi

shell="${THE_LINE_DIR:-$(dirname "$(readlink -f "$0")")/..}"
dir="${XDG_RUNTIME_DIR:-/tmp}/the-line-freeze"
mkdir -p "$dir" && rm -f "$dir"/*.png

for output in $(hyprctl -j monitors | jq -r '.[].name'); do
    grim -o "$output" "$dir/$output.png" &
done
wait

qs -p "$shell" ipc call line freeze true
sleep 0.2

area=$(slurp -d)
[ -n "$area" ] && grim -g "$area" - | wl-copy

qs -p "$shell" ipc call line freeze false
rm -f "$dir"/*.png
