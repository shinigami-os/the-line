<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The Line's settings: what its root helper may do (installed in /usr/share/polkit-1/actions). -->
<policyconfig>
  <vendor>Kira Linux</vendor>
  <action id="org.kira.the-line.settings">
    <description>Change a system setting</description>
    <message>Settings needs your password to change this computer's name, time, battery or face sign-in.</message>
    <icon_name>the-line-settings</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <!-- asked once, then kept a few minutes: several changes in a row need one password -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/the-line/session/the-line-settings-helper</annotate>
  </action>
</policyconfig>
