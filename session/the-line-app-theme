#!/usr/bin/env python3
"""The Line's colours for other apps (colours only): GTK 3 / 4 and Qt through Kvantum, and the icon theme.

    the-line-app-theme '#9A5CFF' [icon theme]

  GTK   ~/.config/gtk-3.0/gtk.css and ~/.config/gtk-4.0/gtk.css: libadwaita's named colours (GTK 4 apps, and GTK 3
        apps with the adw-gtk3 theme). Prefers dark.
  Qt    ~/.config/Kvantum/TheLine: Kvantum's KvGnomeDark recoloured (greys onto The Line's greys by lightness, its
        blue onto the accent), and made the Kvantum theme in use.
  Material ~/.local/state/sleex/user/generated/colors.json: the Material palette Voxel (and any app built on the Sleex
        UI kit) reads, made from The Line's greys and the accent.
  Icons the icon theme (no name: the first installed of ICON_THEMES) for GTK (settings.ini, gsettings) and Qt
        (qt6ct.conf / qt5ct.conf, read once the session sets QT_QPA_PLATFORMTHEME=qt6ct, which it does when qt6ct
        is installed). Only their icon_theme, style and custom_palette keys are written; the rest stays yours.
A file that was there before The Line wrote it is kept once as <file>.before-the-line. Run by session/the-line-apply
(theme), at each accent change. Shapes stay the base themes' own: only colours change.
"""
import colorsys
import json
import os
import re
import shutil
import subprocess
import sys

# The shell's tokens (services/Theme.qml).
BG = "#000000"
SURFACE = "#1B1A18"
SURFACE2 = "#24221F"
BORDER = "#3A3631"
BORDER_STRONG = "#5A544C"
TEXT = "#ECE8E1"
MUTED = "#9C968C"
ACCENT_TEXT = "#0F0D12"
OK = "#6CC495"
ERROR = "#EF7A5E"
WARNING = "#E8B45A"

# Picked in this order when none is set.
ICON_THEMES = ["Papirus-Dark", "Papirus", "breeze-dark", "Adwaita"]

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config"))
MARK = "Written by The Line"


def rgb(hex_):
    hex_ = hex_.lstrip("#")
    return tuple(int(hex_[i:i + 2], 16) / 255 for i in (0, 2, 4))


def hexof(r, g, b):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c * 255))) for c in (r, g, b))


def mix(a, b, t):
    ra, rb = rgb(a), rgb(b)
    return hexof(*(x + (y - x) * t for x, y in zip(ra, rb)))


def keep_original(path):
    """The file as it was before The Line first wrote it, kept once."""
    if os.path.exists(path):
        with open(path, errors="replace") as f:
            if MARK in f.read(400):
                return
        backup = path + ".before-the-line"
        if not os.path.exists(backup):
            shutil.copy2(path, backup)


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    keep_original(path)
    with open(path + ".new", "w") as f:
        f.write(text)
    os.replace(path + ".new", path)


def gtk(accent):
    colours = {
        "accent_color": accent, "accent_bg_color": accent, "accent_fg_color": ACCENT_TEXT,
        "destructive_color": ERROR, "destructive_bg_color": ERROR, "destructive_fg_color": ACCENT_TEXT,
        "success_color": OK, "success_bg_color": OK, "success_fg_color": ACCENT_TEXT,
        "warning_color": WARNING, "warning_bg_color": WARNING, "warning_fg_color": ACCENT_TEXT,
        "error_color": ERROR, "error_bg_color": ERROR, "error_fg_color": ACCENT_TEXT,
        "window_bg_color": SURFACE, "window_fg_color": TEXT,
        "view_bg_color": BG, "view_fg_color": TEXT,
        "headerbar_bg_color": SURFACE, "headerbar_fg_color": TEXT, "headerbar_border_color": BORDER,
        "headerbar_backdrop_color": SURFACE, "headerbar_shade_color": BG,
        "sidebar_bg_color": SURFACE, "sidebar_fg_color": TEXT, "sidebar_backdrop_color": SURFACE,
        "sidebar_shade_color": BG, "secondary_sidebar_bg_color": SURFACE, "secondary_sidebar_fg_color": TEXT,
        "card_bg_color": SURFACE2, "card_fg_color": TEXT, "card_shade_color": BG,
        "dialog_bg_color": SURFACE, "dialog_fg_color": TEXT,
        "popover_bg_color": SURFACE2, "popover_fg_color": TEXT, "popover_shade_color": BG,
        "thumbnail_bg_color": SURFACE2, "thumbnail_fg_color": TEXT,
        "shade_color": "rgba(0, 0, 0, 0.36)", "scrollbar_outline_color": BG,
        "borders": BORDER,
    }
    text = "/* %s (session/the-line-app-theme) from its colours and your accent. Edits here are replaced:\n" \
           " * add your own rules to a file of your own and @import it from another app's css instead. */\n\n" % MARK
    text += "".join("@define-color %s %s;\n" % kv for kv in colours.items())
    for version in ("gtk-3.0", "gtk-4.0"):
        write(os.path.join(CONFIG, version, "gtk.css"), text)
    if shutil.which("gsettings"):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kvantum_base():
    for root in ("/usr/share/Kvantum", "/usr/local/share/Kvantum", os.path.join(HOME, ".local/share/Kvantum")):
        d = os.path.join(root, "KvGnomeDark")
        if os.path.exists(os.path.join(d, "KvGnomeDark.svg")):
            return d
    return None


def kvantum(accent):
    base = kvantum_base()
    if not base:
        return
    # Greys onto The Line's ramp by lightness; coloured parts (the base's blue highlight) onto the accent, at their
    # own lightness relative to the base's highlight.
    ramp = [BG, SURFACE, SURFACE2, BORDER, BORDER_STRONG, MUTED, TEXT]
    ramp_l = [colorsys.rgb_to_hls(*rgb(c))[1] for c in ramp]
    acc_h, acc_l, acc_s = colorsys.rgb_to_hls(*rgb(accent))

    def recolour(m):
        r, g, b = rgb(m.group(0))
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        if s > 0.35 and max(r, g, b) - min(r, g, b) > 0.15:
            return hexof(*colorsys.hls_to_rgb(acc_h, max(0.0, min(1.0, acc_l + (l - 0.5) * 0.5)), acc_s))
        # base theme's lightness 0.08 .. 0.85 spread over the ramp
        t = max(0.0, min(1.0, (l - 0.08) / 0.77))
        i = t * (len(ramp) - 1)
        lo = int(i)
        hi = min(lo + 1, len(ramp) - 1)
        return mix(ramp[lo], ramp[hi], i - lo)

    with open(os.path.join(base, "KvGnomeDark.svg")) as f:
        svg = re.sub(r"#[0-9a-fA-F]{6}\b", recolour, f.read())
    with open(os.path.join(base, "KvGnomeDark.kvconfig")) as f:
        conf = f.read()

    general = {
        "window.color": SURFACE, "base.color": BG, "alt.base.color": SURFACE2, "button.color": SURFACE2,
        "light.color": BORDER_STRONG, "mid.light.color": BORDER, "dark.color": BG, "mid.color": BORDER,
        "highlight.color": accent, "inactive.highlight.color": mix(accent, SURFACE, 0.5),
        "text.color": TEXT, "window.text.color": TEXT, "button.text.color": TEXT, "disabled.text.color": MUTED,
        "tooltip.text.color": TEXT, "highlight.text.color": ACCENT_TEXT, "link.color": accent,
        "link.visited.color": mix(accent, TEXT, 0.35), "progress.indicator.text.color": TEXT,
    }

    def section(m):
        lines = m.group(0).split("\n")
        out = [lines[0]]
        for line in lines[1:]:
            key = line.split("=", 1)[0].strip()
            if key in general:
                continue
            out.append(line)
        while out and out[-1] == "":
            out.pop()
        return "\n".join(out + ["%s=%s" % kv for kv in general.items()]) + "\n\n"

    # per-widget text colours follow the same mapping; the general palette is The Line's own
    conf = re.sub(r"#[0-9a-fA-F]{6}\b", recolour, conf)
    conf = re.sub(r"\[GeneralColors\][^\[]*", section, conf, count=1)
    conf = "# %s (session/the-line-app-theme): Kvantum's KvGnomeDark in The Line's colours. Edits here are replaced.\n" % MARK + conf

    target = os.path.join(CONFIG, "Kvantum", "TheLine")
    write(os.path.join(target, "TheLine.svg"), svg)
    write(os.path.join(target, "TheLine.kvconfig"), conf)
    write(os.path.join(CONFIG, "Kvantum", "kvantum.kvconfig"),
          "# %s: The Line's colours for Qt apps (session/the-line-app-theme).\n[General]\ntheme=TheLine\n" % MARK)


def material(accent):
    """The Sleex UI kit's palette file (Material You role names), from The Line's tokens."""
    light = mix(accent, TEXT, 0.6)
    dim = mix(MUTED, SURFACE, 0.3)
    roles = {
        "background": SURFACE, "on_background": TEXT,
        "surface": SURFACE, "surface_dim": BG, "surface_bright": BORDER, "surface_tint": accent,
        "surface_container_lowest": BG, "surface_container_low": SURFACE, "surface_container": SURFACE2,
        "surface_container_high": mix(SURFACE2, BORDER, 0.5), "surface_container_highest": BORDER,
        "surface_variant": BORDER, "on_surface": TEXT, "on_surface_variant": MUTED,
        "inverse_surface": TEXT, "inverse_on_surface": SURFACE, "inverse_primary": mix(accent, BG, 0.4),
        "outline": BORDER_STRONG, "outline_variant": BORDER, "scrim": "#000000", "shadow": "#000000",
        "primary": accent, "on_primary": ACCENT_TEXT, "primary_container": mix(SURFACE, accent, 0.3),
        "on_primary_container": light, "primary_fixed": light, "primary_fixed_dim": accent,
        "on_primary_fixed": ACCENT_TEXT, "on_primary_fixed_variant": mix(SURFACE, accent, 0.3),
        "secondary": MUTED, "on_secondary": ACCENT_TEXT, "secondary_container": BORDER,
        "on_secondary_container": TEXT, "secondary_fixed": TEXT, "secondary_fixed_dim": MUTED,
        "on_secondary_fixed": ACCENT_TEXT, "on_secondary_fixed_variant": BORDER,
        "tertiary": dim, "on_tertiary": ACCENT_TEXT, "tertiary_container": SURFACE2,
        "on_tertiary_container": TEXT, "tertiary_fixed": TEXT, "tertiary_fixed_dim": dim,
        "on_tertiary_fixed": ACCENT_TEXT, "on_tertiary_fixed_variant": SURFACE2,
        "error": ERROR, "on_error": ACCENT_TEXT, "error_container": mix(SURFACE, ERROR, 0.3),
        "on_error_container": mix(ERROR, TEXT, 0.6),
    }
    state = os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state"))
    write(os.path.join(state, "sleex", "user", "generated", "colors.json"), json.dumps(roles, indent=2) + "\n")


def icon_dirs():
    data = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    return [os.path.join(HOME, ".icons"), os.path.join(HOME, ".local/share/icons")] + [os.path.join(d, "icons") for d in data]


def installed(name):
    return any(os.path.exists(os.path.join(d, name, "index.theme")) for d in icon_dirs())


def set_keys(path, section, values, sep="="):
    """`values` under [section] of an ini file, every other line kept as it was."""
    lines = open(path, errors="replace").read().split("\n") if os.path.exists(path) else []
    out, here, done = [], False, set()

    def rest():
        for k, v in values.items():
            if k not in done:
                out.append("%s%s%s" % (k, sep, v))
                done.add(k)

    for line in lines:
        head = re.fullmatch(r"\s*\[(.+)\]\s*", line)
        if head:
            if here:
                rest()
            here = head.group(1) == section
        elif here:
            key = line.split("=", 1)[0].strip()
            if key in values:
                out.append("%s%s%s" % (key, sep, values[key]))
                done.add(key)
                continue
        out.append(line)
    if here:
        rest()
    if len(done) < len(values):
        while out and out[-1] == "":
            out.pop()
        if out:
            out.append("")
        out.append("[%s]" % section)
        rest()
    keep_original(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".new", "w") as f:
        f.write("\n".join(out).rstrip("\n") + "\n")
    os.replace(path + ".new", path)


# Papirus' folder colours and their hue in degrees; a grey accent gets the grey folders.
FOLDER_HUES = {"red": 4, "deeporange": 14, "orange": 32, "yellow": 50, "green": 125, "teal": 172, "cyan": 190,
               "blue": 215, "indigo": 238, "violet": 268, "magenta": 300, "pink": 332}


def folder_colour(accent):
    h, s, _ = colorsys.rgb_to_hsv(*rgb(accent))
    if s < 0.15:
        return "grey"
    hue = h * 360
    return min(FOLDER_HUES, key=lambda c: min(abs(hue - FOLDER_HUES[c]), 360 - abs(hue - FOLDER_HUES[c])))


def tinted_icons(base, accent):
    """~/.local/share/icons/TheLine-<base>: the base theme with its folders in the accent's colour. Papirus draws a
    coloured folder as folder-<colour>[-name].svg and points folder[-name].svg at the blue ones: here they point at
    the accent's.
    Returns the name to use; the base itself when it has no coloured folders."""
    root = next((os.path.join(d, base) for d in icon_dirs() if os.path.exists(os.path.join(d, base, "index.theme"))), "")
    if not root or not base.lower().endswith("papirus") and "papirus" not in base.lower():
        return base
    colour = folder_colour(accent)
    name = "TheLine-" + base
    out = os.path.join(HOME, ".local", "share", "icons", name)
    places = []
    for dirpath, _, files in os.walk(root, followlinks=True):
        if os.path.basename(dirpath) != "places":
            continue
        rel = os.path.relpath(dirpath, root)
        have = set(files)
        links = []
        for f in files:
            if f == "folder.svg":
                new = "folder-%s.svg" % colour
            elif f.startswith("folder-") and ("folder-blue-" + f[7:]) in have:
                new = "folder-%s-%s" % (colour, f[7:])
            else:
                continue
            if new in have:
                links.append((f, os.path.join(dirpath, new)))
        if links:
            places.append((rel, links))
    if not places:
        return base
    shutil.rmtree(out, ignore_errors=True)
    sections = []
    for rel, links in sorted(places):
        os.makedirs(os.path.join(out, rel))
        for f, target in links:
            os.symlink(target, os.path.join(out, rel, f))
        size = re.match(r"(\d+)x\d+(@(\d+))?", rel)
        sections.append("[%s]\nContext=Places\nSize=%s\n%sType=Fixed\n" % (
            rel, size.group(1) if size else "48", "Scale=%s\n" % size.group(3) if size and size.group(3) else ""))
    with open(os.path.join(out, "index.theme"), "w") as f:
        f.write("[Icon Theme]\nName=%s\nComment=%s with the accent's folders (%s). %s\nInherits=%s\nHidden=true\nDirectories=%s\n\n%s" % (
            name, base, colour, MARK, base, ",".join(r for r, _ in sorted(places)), "\n".join(sections)))
    return name


def icons(name, accent):
    if not name or not installed(name):
        name = next((t for t in ICON_THEMES if installed(t)), "")
    if not name:
        return
    name = tinted_icons(name, accent)
    gtk3 = {"gtk-icon-theme-name": name, "gtk-application-prefer-dark-theme": "1"}
    # GTK 3 apps read the colours of gtk.css only through adw-gtk3
    if any(os.path.exists(os.path.join(d, "adw-gtk3-dark")) for d in ("/usr/share/themes", os.path.join(HOME, ".themes"),
                                                                        os.path.join(HOME, ".local/share/themes"))):
        gtk3["gtk-theme-name"] = "adw-gtk3-dark"
    set_keys(os.path.join(CONFIG, "gtk-3.0", "settings.ini"), "Settings", gtk3)
    set_keys(os.path.join(CONFIG, "gtk-4.0", "settings.ini"), "Settings", {"gtk-icon-theme-name": name})
    if shutil.which("gsettings"):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", name],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # style: Kvantum draws the widgets (in the TheLine theme); custom_palette off, or qt6ct's palette covers its colours
    for ct in ("qt6ct", "qt5ct"):
        set_keys(os.path.join(CONFIG, ct, ct + ".conf"), "Appearance",
                 {"icon_theme": name, "style": "kvantum", "custom_palette": "false"})


def main():
    accent = sys.argv[1] if len(sys.argv) > 1 else "#9A5CFF"
    if not re.fullmatch(r"#?[0-9a-fA-F]{6}", accent):
        accent = "#9A5CFF"
    accent = "#" + accent.lstrip("#").lower()
    gtk(accent)
    kvantum(accent)
    material(accent)
    icons(sys.argv[2] if len(sys.argv) > 2 else "", accent)


if __name__ == "__main__":
    main()
