#!/bin/sh
# The settings app's root side, run through pkexec (the line's polkit dialog asks for the password).
# Only these verbs, every argument checked before anything is touched:
#   hostname NAME                 /etc/hostname, /etc/hosts (127.0.1.1), the running hostname
#   timezone Region/City          /etc/localtime (and /etc/timezone)
#   ntp on|off                    chronyd: started and enabled, or stopped and kept down (runit's down file)
#   time "YYYY-MM-DD HH:MM[:SS]"  the clock, then the hardware clock (only with ntp off)
#   charge-limit 50..100          the battery stops charging there; kept across reboots by a udev rule
#   face add|remove ID|clear      the calling user's howdy face models
#   face-pam hyprlock|greetd on|off   face sign-in for unlocking the screen, or for the login screen
set -u

die() {
    echo "$*" >&2
    exit 1
}

# The user who asked (pkexec says who), for howdy.
caller() {
    awk -F: -v uid="${PKEXEC_UID:-}" '$3 == uid { print $1; exit }' /etc/passwd
}

case "${1:-}" in
hostname)
    name="${2:-}"
    printf '%s' "$name" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$' || die "A name with letters, digits and dashes (not at the ends)"
    old=$(cat /etc/hostname 2>/dev/null)
    printf '%s\n' "$name" > /etc/hostname
    hostname "$name"
    # 127.0.1.1 names this computer for the programs that look it up
    grep -v '^127\.0\.1\.1[[:space:]]' /etc/hosts > /etc/hosts.new
    printf '127.0.1.1   %s\n' "$name" >> /etc/hosts.new
    cat /etc/hosts.new > /etc/hosts
    rm -f /etc/hosts.new
    ;;
timezone)
    zone="${2:-}"
    printf '%s' "$zone" | grep -Eq '^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$' || die "Not a time zone"
    [ -f "/usr/share/zoneinfo/$zone" ] || die "Unknown time zone: $zone"
    ln -sf "/usr/share/zoneinfo/$zone" /etc/localtime
    printf '%s\n' "$zone" > /etc/timezone
    ;;
ntp)
    case "${2:-}" in
    on)
        rm -f /etc/sv/chronyd/down
        sv up chronyd
        ;;
    off)
        touch /etc/sv/chronyd/down
        sv down chronyd
        ;;
    *) die "ntp on|off" ;;
    esac
    ;;
time)
    t="${2:-}"
    printf '%s' "$t" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}(:[0-9]{2})?$' || die "Write it as 2026-11-08 16:30"
    [ -f /etc/sv/chronyd/down ] || die "Turn off the automatic time first"
    date -s "$t" >/dev/null || die "That date doesn't exist"
    hwclock -w 2>/dev/null
    ;;
charge-limit)
    n="${2:-}"
    case "$n" in ''|*[!0-9]*) die "A percentage" ;; esac
    [ "$n" -ge 50 ] && [ "$n" -le 100 ] || die "Between 50 and 100 %"
    bat=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n1)
    [ -n "$bat" ] && [ -w "$bat/charge_control_end_threshold" ] || die "This battery doesn't offer a charge limit"
    echo "$n" > "$bat/charge_control_end_threshold"
    name=$(basename "$bat")
    if [ "$n" -eq 100 ]; then
        rm -f /etc/udev/rules.d/61-the-line-charge-limit.rules
    else
        printf '# Written by The Line (Settings > Power & idle): the battery stops charging at %s %%.\nSUBSYSTEM=="power_supply", KERNEL=="%s", ATTR{charge_control_end_threshold}="%s"\n' \
            "$n" "$name" "$n" > /etc/udev/rules.d/61-the-line-charge-limit.rules
    fi
    ;;
face)
    user=$(caller)
    [ -n "$user" ] || die "Who is asking?"
    case "${2:-}" in
    add) howdy -U "$user" -y add ;;
    remove)
        id="${3:-}"
        case "$id" in ''|*[!0-9]*) die "A model number" ;; esac
        howdy -U "$user" -y remove "$id"
        ;;
    clear) howdy -U "$user" -y clear ;;
    *) die "face add|remove ID|clear" ;;
    esac
    ;;
face-pam)
    service="${2:-}"
    case "$service" in hyprlock|greetd) ;; *) die "hyprlock or greetd" ;; esac
    f="/etc/pam.d/$service"
    [ -f "$f" ] || die "No PAM file for $service"
    line='auth sufficient /usr/lib/security/pam_howdy.so  # the-line: face sign-in'
    grep -v 'pam_howdy.so  # the-line' "$f" > "$f.new"
    case "${3:-}" in
    # first, so the face is tried before the password; "sufficient": if it fails, the password still works
    on) { echo "$line"; cat "$f.new"; } > "$f.tmp" && mv "$f.tmp" "$f.new" ;;
    off) ;;
    *) rm -f "$f.new"; die "on or off" ;;
    esac
    cat "$f.new" > "$f"
    rm -f "$f.new"
    ;;
*)
    die "usage: the-line-settings-helper hostname|timezone|ntp|time|charge-limit|face|face-pam ..."
    ;;
esac
