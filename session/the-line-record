#!/bin/sh
# Screen recording, SUPER+ALT+R: pick an area, it records to ~/Videos/Recordings; again to stop.
# A notification says when it starts and when it stops (with where the file is), so a recording is never forgotten.
dir="$HOME/Videos/Recordings"

notify() {
    notify-send -a "Screen recording" -i media-record "$1" "$2" 2>/dev/null
}

if pkill -INT -x wf-recorder; then
    exit 0   # the recording below says it stopped
fi
if ! command -v wf-recorder >/dev/null 2>&1; then
    notify "Can't record" "wf-recorder isn't installed."
    exit 1
fi

area=$(slurp) || exit 0
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H.%M.%S).mp4"
notify "Recording" "SUPER+ALT+R again to stop."
wf-recorder -g "$area" -f "$file" >/dev/null 2>&1
if [ -s "$file" ]; then
    notify "Recording saved" "${file#"$HOME"/}"
else
    notify "Recording stopped" "Nothing was saved."
fi
